# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local — it is in .gitignore.

# Public site URL (used for sitemap, canonical, SEO)
NEXT_PUBLIC_SITE_URL=https://dooballlaos.com

# Firebase Client Config (from Firebase Console → Project Settings → General)
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://football-888-b9a7e-default-rtdb.asia-southeast1.firebasedatabase.app
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin SDK (JSON string or Base64 of serviceAccountKey.json)
# Generate at: Firebase Console → Project Settings → Service Accounts → Generate new key
FIREBASE_SERVICE_ACCOUNT_KEY=

# Admin panel auth
ADMIN_PASSWORD=
ADMIN_SECRET_KEY=

# Telegram bot (for job commands)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_WEBHOOK_SECRET=

# Optional: Google/Yandex site verification tokens
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_YANDEX_SITE_VERIFICATION=